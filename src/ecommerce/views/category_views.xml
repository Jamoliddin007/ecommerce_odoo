<odoo>
    <data>
        <record id="view_category_list" model="ir.ui.view">
            <field name="name">ecommerce.category.list</field>
            <field name="model">ecommerce.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="product_count"/>
                </list>
            </field>
        </record>

        <record id="view_category_form" model="ir.ui.view">
            <field name="name">ecommerce.category.form</field>
            <field name="model">ecommerce.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="product_count" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Mahsulotlar">
                                <field name="product_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="sale_price"/>
                                        <field name="cost_price"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_categories" model="ir.actions.act_window">
            <field name="name">Kategoriyalar</field>
            <field name="res_model">ecommerce.category</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
