<odoo>
    <data>
        <record id="view_order_list" model="ir.ui.view">
            <field name="name">ecommerce.order.list</field>
            <field name="model">ecommerce.order</field>
            <field name="arch" type="xml">
                <list>
                    <field name="customer_id"/>
                    <field name="deadline"/>
                    <field name="days_left"/>
                    <field name="product_count"/>
                </list>
            </field>
        </record>

        <record id="view_order_form" model="ir.ui.view">
            <field name="name">ecommerce.order.form</field>
            <field name="model">ecommerce.order</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                             <field name="name"/>
                            <field name="customer_id"/>
                            <field name="deadline"/>
                            <field name="days_left" readonly="1"/>
                            <field name="product_count" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Order Lines">
                                <field name="order_line_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                        <field name="tax_percent"/>
                                        <field name="discount_percent"/>
                                        <field name="total_price" readonly="1"/>
                                        <field name="profit_percent" readonly="1"/>
                                        <field name="profit_amount" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_orders" model="ir.actions.act_window">
            <field name="name">Buyurtmalar</field>
            <field name="res_model">ecommerce.order</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
