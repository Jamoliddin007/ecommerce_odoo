<odoo>
  <data>
    <record id="view_ecommerce_order_line_list" model="ir.ui.view">
      <field name="name">ecommerce.order.line.list</field>
      <field name="model">ecommerce.order.line</field>
      <field name="arch" type="xml">
        <list string="Buyurtma qatorlari">
          <field name="order_id"/>
          <field name="customer_id"/>
          <field name="product_id"/>
          <field name="quantity"/>
          <field name="price_unit"/>
          <field name="total_price"/>
        </list>
      </field>
    </record>

    <record id="view_ecommerce_order_line_form" model="ir.ui.view">
      <field name="name">ecommerce.order.line.form</field>
      <field name="model">ecommerce.order.line</field>
      <field name="arch" type="xml">
        <form string="Buyurtma qatori">
          <sheet>
            <group>
              <field name="order_id"/>
              <field name="product_id"/>
            </group>
            <group>
              <field name="quantity"/>
              <field name="price_unit"/>
              <field name="total_price" readonly="1"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_ecommerce_order_line" model="ir.actions.act_window">
      <field name="name">Buyurtma qatorlari</field>
      <field name="res_model">ecommerce.order.line</field>
      <field name="view_mode">list,form</field>
    </record>
  </data>
</odoo>
